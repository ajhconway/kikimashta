{
  "name": "kikimashta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/package-notices.mjs --public && vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/package-notices.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && node --test scripts/*.test.mjs scripts/content/*.test.mjs",
    "test:cards": "python3 -m unittest discover -s scripts/cards -p 'test_*.py' && python3 scripts/cards/validate.py",
    "test:audio": "python3 -m unittest discover -s scripts/content -p 'test_*.py'",
    "audio:audition:elevenlabs": "node --env-file-if-exists=.env.local scripts/content/audition-elevenlabs.mjs",
    "audio:cards:elevenlabs": "node --env-file-if-exists=.env.local scripts/content/generate-elevenlabs-cards.mjs",
    "audio:contextual:elevenlabs": "node scripts/content/generate-contextual-audition.mjs",
    "audio:contextual:review": "node scripts/content/build-contextual-audio-review.mjs",
    "content:illustrate": "node scripts/content/illustrate-levels-1-2.mjs && node scripts/content/illustrate-levels-3-4.mjs && node scripts/content/illustrate-level-5.mjs",
    "content:library": "node scripts/content/build-vocabulary-library.mjs",
    "content:contextual:validate": "node scripts/content/validate-contextual.mjs",
    "content:contextual:review": "node scripts/content/build-contextual-review.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:content-review": "E2E_CONTENT_REVIEW=1 playwright test content-review",
    "check": "npm run lint && npm test && npm run test:audio && npm run test:cards && npm run build",
    "audio:spanish:elevenlabs": "node scripts/content/generate-spanish-travel-pack.mjs",
    "audio:spanish:review": "node scripts/content/build-spanish-audio-review.mjs",
    "content:spanish:activate": "node scripts/content/stage-spanish-travel-pack.mjs"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.77.0",
    "@supabase/supabase-js": "2.119.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ts-fsrs": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
